<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Interfaz.InventarioController">
    <top>
        <VBox fx:id="panelSuperiorBanner" alignment="CENTER" style="-fx-background-color: #37474F;">
            <children>
                <ImageView fx:id="imagenTitular" fitHeight="70.0" preserveRatio="false" />
            </children>
        </VBox>
    </top>
    <right>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #F0FDFB; -fx-border-color: #B0BEC5; -fx-border-width: 0 0 0 2;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Consultas" textFill="#5faf7a">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <Label text="Verificación Rápida de Stock/Cliente" textFill="#37474F" />
            <TextField fx:id="textFieldConsulta" />
            <Button fx:id="botonAplicarConsulta" disable="true" style="-fx-background-color: #FFC857; -fx-text-fill: white; -fx-font-weight: bold;" text="Aplicar">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
                <Label text="Opciones de Recorrido" textFill="#5faf7a">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Label>
                <ComboBox fx:id="selectorRecorrido" maxWidth="1.7976931348623157E308" promptText="Seleccione un recorrido" style="-fx-background-color: #FFB6C9;" />
                <ScrollPane fx:id="panelScrollAlgoritmos" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" />
                <Button fx:id="botonRecorrido" disable="true" maxWidth="1.7976931348623157E308" style="-fx-background-color: #7FC99A; -fx-text-fill: white; -fx-font-weight: bold;" text="Realizar Recorrido">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
                </Button>
                <Button fx:id="botonReturn" maxWidth="1.7976931348623157E308" style="-fx-background-color: #7ECBA7; -fx-text-fill: white;" text="Regresar al Menu Principal">
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
                </Button>
            <Button fx:id="botonCargar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #FFAECF;" text="⬆ Cargar CSV" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            </children>
        </VBox>
    </right>
    <center>
        <TabPane style="-fx-border-color: #B0BEC5; -fx-border-width: 0 2 0 0;" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Visualizador de Datos (CSV)">
                    <content>
                        <VBox alignment="CENTER_LEFT" spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="tablaDatos" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
