<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Interfaz.InventarioController"
            style="-fx-background-color: #0F3048;">

    <top>
        <VBox fx:id="panelSuperiorBanner" alignment="CENTER"
              style="-fx-background-color: #154D71;">
            <children>
                <ImageView fx:id="imagenTitular" fitHeight="70.0" preserveRatio="false" />
                <Label text="ÁRBOL BALANCEADO - INVENTARIO Y RECORRIDOS"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                    <padding>
                        <Insets top="10.0" bottom="12.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </top>

    <right>
        <VBox prefWidth="250.0" spacing="10.0"
              style="-fx-background-color: #0F3048; -fx-border-color: #1C6EA4; -fx-border-width: 0 0 0 2;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Consultas" textFill="#FFF9AF">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <Label text="Verificación Rápida de Stock/Cliente" textFill="WHITE" />

                <TextField fx:id="textFieldConsulta"
                           style="-fx-background-color: #ffffff; -fx-text-fill: white; -fx-border-color: #1C6EA4; -fx-border-width: 1;" />

                <Button fx:id="botonAplicarConsulta" disable="true"
                        style="-fx-background-color: #33A1E0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"
                        text="Aplicar">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Label text="Opciones de Recorrido" textFill="#FFF9AF">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Label>

                <ComboBox fx:id="selectorRecorrido"
                          maxWidth="1.7976931348623157E308"
                          promptText="Seleccione un recorrido"
                          style="-fx-background-color: #ffffff; -fx-text-fill: white; -fx-border-color: #1C6EA4; -fx-border-width: 2;" />

                <ScrollPane fx:id="panelScrollAlgoritmos"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            VBox.vgrow="ALWAYS" />

                <Button fx:id="botonRecorrido" disable="true"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: #33A1E0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"
                        text="Realizar Recorrido">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="botonReturn"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: transparent; -fx-text-fill: #FFF9AF; -fx-border-color: #FFF9AF; -fx-border-width: 1.5; -fx-background-radius: 8; -fx-border-radius: 8;"
                        text="Regresar al Menu Principal">
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>

                <Button fx:id="botonCargar"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        style="-fx-background-color: #1C6EA4; -fx-text-fill: white; -fx-background-radius: 8;"
                        text="⬆ Cargar CSV">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

            </children>
        </VBox>
    </right>

    <center>
        <TabPane style="-fx-border-color: #1C6EA4; -fx-border-width: 0 2 0 0;"
                 tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Visualizador de Datos (CSV)">
                    <content>
                        <VBox alignment="CENTER_LEFT" spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="tablaDatos"
                                           VBox.vgrow="ALWAYS"
                                           style="-fx-border-color: #1C6EA4; -fx-border-width: 1;" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
