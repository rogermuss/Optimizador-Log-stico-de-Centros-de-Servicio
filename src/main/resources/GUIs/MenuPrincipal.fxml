<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Interfaz.MenuPrincipalController">
    <children>
        <ImageView fx:id="fondoMenu" fitHeight="720.0" fitWidth="1280.0" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@MenuPrincipal.png" />
            </image>
        </ImageView>
        <VBox alignment="CENTER_LEFT"
              spacing="50.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="400.0"
              AnchorPane.topAnchor="30.0">
            <children>
                <Button fx:id="botonOptimizar"
                        onAction="#alDarOptimizar"
                        prefHeight="90.0"
                        prefWidth="380.0"
                        text="Optimizar">
                    <font>
                        <Font name="System Bold" size="100.0" />
                    </font>
                </Button>

                <Button fx:id="botonCreditos"
                        onAction="#alDarCreditos"
                        prefHeight="90.0"
                        prefWidth="380.0"
                        text="Créditos">
                    <font>
                        <Font name="System Bold" size="100.0" />
                    </font>
                </Button>

                <Button fx:id="botonSalir"
                        onAction="#alDarSalir"
                        prefHeight="90.0"
                        prefWidth="380.0"
                        text="Salir">
                    <font>
                        <Font name="System Bold" size="100.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
